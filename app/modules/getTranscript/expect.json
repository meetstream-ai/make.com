[
  {
    "name": "transcriptId",
    "label": "Transcript ID",
    "type": "text",
    "required": true,
    "validate": {
      "min": 1,
      "max": 256,
      "pattern": "^(?!\\.{1,2}$)(?=[^\\r\\n]*\\S)[^\\r\\n]+$(?![\\s\\S])"
    }
  },
  {
    "name": "raw",
    "label": "Raw Provider Response",
    "type": "boolean",
    "required": true,
    "default": false
  }
]
