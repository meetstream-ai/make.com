# Include limit_req_zone in the nginx http block. Replace domain/certificate
# paths before loading this example. Tune rate/burst for lifecycle traffic.
limit_req_zone $binary_remote_addr zone=meetstream_ingress:10m rate=10r/s;
server {
    listen 443 ssl;
    server_name relay.example.invalid;
    ssl_certificate /etc/letsencrypt/live/relay.example.invalid/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/relay.example.invalid/privkey.pem;
    client_max_body_size 256k;
    client_body_timeout 10s;
    location = /events {
        limit_req zone=meetstream_ingress burst=50 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:3333;
        proxy_read_timeout 10s;
        proxy_connect_timeout 2s;
        # Request body bytes and signature headers must pass unchanged.
    }
    location / { return 404; }
}
